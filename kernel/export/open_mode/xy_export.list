/*** 以下宏值用来开关需要暴露给app.bin的system.bin里的外部模块API，设为1表示该文件中相关API会被链接 ***/
/*** 若system.bin编译报FLASH空间不足"overflow len"， 可以关闭不用的模块API宏,也可以注掉不需要的某API***/

#define CM_FTP_API      0     
#define CM_AUDIO_API    0    /*cm_audio_player.h  cm_audio_recorder.h，要打开需将对应的define.cmake中的AUDIO设为ON,TTS用户根据需要决定是否设为ON*/
#define CM_LWM2M_API    1

